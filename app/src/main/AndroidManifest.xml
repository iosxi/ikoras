<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Install-time (normal) permissions: no dialog is ever shown.
         MODIFY_AUDIO_SETTINGS: the equalizer effects, and the whole-output DynamicsProcessing that
         carries both the fine volume (input gain) and the EQ while YouTube plays.
         VIBRATE: the long-press cues of the volume keys (can be switched off in the settings). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Runtime permission, asked only when "常駐して待つ" or whole-output mode is turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Runtime permission, asked only when 機器プリセット lists the paired Bluetooth devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Optional, never granted at install: only `adb shell pm grant com.ikoras
         android.permission.DUMP` enables it. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Not permissions: only makes these kinds of apps visible, for names and pickers. -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <!-- Apps with a home-screen icon: effect owners by name, and the apps a long press can open. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Theme.Ikora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opened from a player's "Equalizer" menu (YT Music: Settings > Playback). -->
            <intent-filter>
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CATEGORY_CONTENT_MUSIC" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DevicesActivity"
            android:exported="false" />

        <!-- The volume keys: long press, fine volume (was volzz). Its own light theme, as before. -->
        <activity
            android:name=".VolumeActivity"
            android:exported="false"
            android:label="@string/keys_title"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- Players announce the audio session they start and stop playing. -->
        <receiver
            android:name=".SessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="com.ikoras.SELF_TEST" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".EqService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies an audio equalizer to another app's playback session" />
        </service>

        <!-- Which app is playing (YouTube), from media sessions. 通知へのアクセス, set by the user. -->
        <service
            android:name=".PlayingListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The volume keys (was volzz): enabled by the user in accessibility settings. -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
