<?xml version="1.0" encoding="utf-8"?>
<!-- 「音量キー」タブ（元 volzz）: 先頭はこのタブ専用のスイッチ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="32dp">

        <Switch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enabled_label"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            style="@style/Hint"
            android:text="@string/enabled_desc" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/intro"
            android:textSize="14sp" />

        <!-- 状態（ユーザー補助で ON にするまでの案内。動作中になったら見出しごと隠す） -->
        <TextView
            android:id="@+id/status_title"
            style="@style/SectionTitle"
            android:text="@string/status_title" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/status_off" />

        <Button
            android:id="@+id/open_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_settings" />

        <!-- 設定 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/settings_title" />


        <Switch
            android:id="@+id/only_while_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/only_while_playing_label"
            android:textSize="16sp" />

        <TextView
            style="@style/Hint"
            android:text="@string/only_while_playing_desc" />

        <Switch
            android:id="@+id/vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vibrate_label"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/vibrate_warning"
            style="@style/Hint"
            android:text="@string/vibrate_off_warning"
            android:textColor="@color/text_warn"
            android:visibility="gone" />

        <TextView
            style="@style/Hint"
            android:text="@string/vibrate_desc" />

        <TextView
            android:id="@+id/vibrate_more_toggle"
            style="@style/More" />

        <LinearLayout
            android:id="@+id/vibrate_more"
            style="@style/MoreBody">

            <TextView
                style="@style/Hint"
                android:text="@string/vibrate_more" />
        </LinearLayout>

        <!-- 割り当て -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/assign_title" />

        <Button
            android:id="@+id/assign_up_long"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/assign_down_long"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/assign_up_super"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/assign_down_super"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/Hint"
            android:text="@string/assign_desc" />

        <TextView
            android:id="@+id/assign_more_toggle"
            style="@style/More" />

        <LinearLayout
            android:id="@+id/assign_more"
            style="@style/MoreBody">

            <TextView
                style="@style/Hint"
                android:text="@string/assign_more" />
        </LinearLayout>

        <!-- 長押し時間 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/threshold_title" />

        <TextView
            android:id="@+id/threshold_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/Hint"
            android:text="@string/threshold_desc" />

        <!-- 超長押し時間 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/super_threshold_title" />

        <TextView
            android:id="@+id/super_threshold_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/super_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/super_threshold_detail"
            style="@style/Hint" />

        <TextView
            style="@style/Hint"
            android:text="@string/super_threshold_desc" />

        <TextView
            android:id="@+id/super_threshold_more_toggle"
            style="@style/More" />

        <LinearLayout
            android:id="@+id/super_threshold_more"
            style="@style/MoreBody">

            <TextView
                android:id="@+id/super_threshold_more_text"
                style="@style/Hint" />
        </LinearLayout>

        <!-- 短押しの扱い（設計の理由だけなので、まるごと畳む） -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/mode_title" />

        <TextView
            android:id="@+id/mode_more_toggle"
            style="@style/More" />

        <LinearLayout
            android:id="@+id/mode_more"
            style="@style/MoreBody">

            <TextView
                style="@style/Hint"
                android:text="@string/mode_desc" />
        </LinearLayout>

        <!-- 動作確認（困ったときに開くもの） -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/diag_title" />

        <TextView
            android:id="@+id/diag_more_toggle"
            style="@style/More" />

        <LinearLayout
            android:id="@+id/diag_more"
            style="@style/MoreBody">

            <TextView
                android:id="@+id/diag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="14sp" />

            <TextView
                style="@style/Hint"
                android:text="@string/diag_desc" />
        </LinearLayout>

        <!-- 権限 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/perm_title" />

        <TextView
            style="@style/Hint"
            android:text="@string/perm_desc" />

        <TextView
            android:id="@+id/perm_more_toggle"
            style="@style/More" />

        <LinearLayout
            android:id="@+id/perm_more"
            style="@style/MoreBody">

            <TextView
                style="@style/Hint"
                android:text="@string/perm_more" />
        </LinearLayout>

    
</LinearLayout>
