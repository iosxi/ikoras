<?xml version="1.0" encoding="utf-8"?>
<!-- 「音量段階」タブ（元 voom）: 先頭はこのタブ専用のスイッチ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="32dp">

        <Switch
            android:id="@+id/fine_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fine_enabled_label"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            style="@style/Hint"
            android:text="@string/fine_enabled_desc" />
        <!-- 細かい音量は音量キーの短押しで動く。音量キーのサービスの状態をここにも出す -->
        <TextView
            android:id="@+id/steps_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/steps_open_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/open_settings" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/status_title" />


        <TextView
            android:id="@+id/fine_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />


        <TextView
            android:id="@+id/fine_steps_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/fine_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/fine_steps_detail"
            style="@style/Hint" />

        <TextView
            style="@style/Hint"
            android:text="@string/fine_desc" />

        <TextView
            android:id="@+id/fine_more_toggle"
            style="@style/More" />

        <LinearLayout
            android:id="@+id/fine_more"
            style="@style/MoreBody">

            <TextView
                style="@style/Hint"
                android:text="@string/fine_desc_more" />
        </LinearLayout>


</LinearLayout>
